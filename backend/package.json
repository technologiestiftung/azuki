{
	"name": "azuki-backend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=../.env src/index.ts",
		"build": "tsc",
		"start": "tsx --env-file=../.env src/index.ts",
		"fetch-berufe": "tsx ../scripts/fetch-berufe.ts",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\" \"tests/**/*\"",
		"prettier": "prettier --write src tests",
		"prettier:ci": "prettier --check src tests"
	},
	"dependencies": {
		"@azuki/shared": "*",
		"@hono/node-server": "1.19.17",
		"@supabase/supabase-js": "^2.105.1",
		"hono": "4.13.8",
		"openai": "6.49.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@technologiestiftung/eslint-config": "0.3.1",
		"@types/node": "22.19.11",
		"eslint": "9.11.1",
		"globals": "15.10.0",
		"prettier": "3.3.3",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vitest": "2.1.9"
	}
}
