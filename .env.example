# OpenRouter API key for AI-powered ranking & explanations.
# Without it, results fall back to the deterministic pre-filter only.
OPENROUTER_API_KEY=

# REQUIRED in production: password guarding all admin routes (/api/personas,
# /api/eval/*, /api/match, /api/unlock). The frontend sends it as the
# `x-app-password` request header. In production the server refuses to start
# without this set. In dev it may be empty (server logs a warning).
APP_PASSWORD=

# Optional: prefill the questionnaire profile in preview/local builds.
# Set to `true` to enable; omit or leave empty otherwise.
VITE_PREFILL_PROFILE=


# Optional: use mock results for the search page.
# Set to `true` to enable; omit or leave empty otherwise.
VITE_USE_MOCK_RESULTS=

# Optional: skip the real HubSpot contact-form submission and just log the
# payload that would have been sent. Set to `true` to enable; omit or
# leave empty otherwise.
HUBSPOT_MOCK_SUBMIT=