# --- Backend ----------------------------------------------------------------

# Enables AI ranking & explanations. Unset = deterministic pre-filter only.
OPENROUTER_API_KEY=

# Shared app password, sent by the frontend as the `x-app-password` header.
# Guards /api/match and every other AI/write route. Production refuses to
# start without it.
APP_PASSWORD=

# `production` makes APP_PASSWORD mandatory. Usually set by the host.
NODE_ENV=

# Standalone server port. Default 3001. Ignored on serverless hosts.
PORT=

# `true` logs the HubSpot contact payload instead of submitting it.
HUBSPOT_MOCK_SUBMIT=

# Any value dumps unparseable LLM responses to bad-llm-response-*.bin. Debug only.
AZUKI_DUMP_BAD_LLM_RESPONSES=


# --- Supabase (optional, dev only) -------------------------------------------
# Persona store behind /api/personas* and /api/eval/run. Unset = those routes
# 502; questionnaire and matching are unaffected. Schema: backend/eval/migrations/.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- Frontend (build time) ----------------------------------------------------
# Vite reads this same root file (`envDir` in frontend/vite.config.ts) and bakes
# the values into the bundle. Never put a secret in a VITE_ variable.

# API base URL. Default `/api`. Only needed for a cross-origin backend.
VITE_API_URL=

# `true` prefills the questionnaire profile.
VITE_PREFILL_PROFILE=

# `true` serves mock results on the search page.
VITE_USE_MOCK_RESULTS=


# --- Data scripts (optional) --------------------------------------------------

# Source dir for the DAZUBI/Destatis .xlsx snapshots used by
# `npm run data:build-trainee-fixtures`. Default data/popularity-source/.
POPULARITY_DATA_DIR=
